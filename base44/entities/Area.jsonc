{
  "name": "Area",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "title": "Project ID"
    },
    "name": {
      "type": "string",
      "title": "Area Name"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "Walkway/Patio",
        "Site Management & Daily Cleanup",
        "Bed Preparation",
        "Rough Grading & Hauling",
        "Demolition & Removals",
        "Bed Edging",
        "Planting",
        "Mulch",
        "Drainage",
        "Lawn Repair & Install",
        "Boulders/Accents & Structures"
      ],
      "title": "Operation Type"
    },
    "patio_data": {
      "type": "string",
      "title": "Patio Configuration Data"
    },
    "site_mgmt_data": {
      "type": "string",
      "title": "Site Management Configuration Data"
    },
    "bed_prep_data": {
      "type": "string",
      "title": "Bed Preparation Configuration Data"
    },
    "rough_grading_data": {
      "type": "string",
      "title": "Rough Grading & Hauling Configuration Data"
    },
    "demolition_data": {
      "type": "string",
      "title": "Demolition & Removals Configuration Data"
    },
    "bed_edging_data": {
      "type": "string",
      "title": "Bed Edging Configuration Data"
    },
    "planting_data": {
      "type": "string",
      "title": "Planting Configuration Data"
    },
    "mulch_data": {
      "type": "string",
      "title": "Mulch Configuration Data"
    },
    "drainage_data": {
      "type": "string",
      "title": "Drainage Configuration Data"
    },
    "lawn_data": {
      "type": "string",
      "title": "Lawn Repair & Install Configuration Data"
    },
    "boulders_data": {
      "type": "string",
      "title": "Boulders/Accents & Structures Configuration Data"
    },
    "status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Complete"
      ],
      "title": "Status"
    }
  },
  "required": [
    "project_id",
    "name"
  ]
}