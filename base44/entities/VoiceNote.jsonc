{
  "name": "VoiceNote",
  "type": "object",
  "properties": {
    "area_id": {
      "type": "string",
      "title": "Area ID"
    },
    "audio_url": {
      "type": "string",
      "title": "Audio File URL"
    },
    "duration": {
      "type": "number",
      "title": "Duration in seconds"
    }
  },
  "required": [
    "area_id",
    "audio_url"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}