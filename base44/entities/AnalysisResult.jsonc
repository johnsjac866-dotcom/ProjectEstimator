{
  "name": "AnalysisResult",
  "type": "object",
  "properties": {
    "area_id": {
      "type": "string",
      "title": "Area ID"
    },
    "summary": {
      "type": "string",
      "title": "Analysis Summary"
    },
    "key_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Key Items"
    },
    "recommended_operations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Recommended Operations"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    }
  },
  "required": [
    "area_id"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}